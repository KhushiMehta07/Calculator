  <property name="styleSheet">
   <string notr="true">/* ================================
   iPHONE CALCULATOR STYLE
   ================================ */

QMainWindow#Calculator {
    background-color: #000000;
}


/* ================================
   DISPLAY
   ================================ */

QLineEdit#display {
    background-color: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 0px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 42px;
    font-weight: 400;

    padding: 10px 18px;
}


/* ================================
   ALL BUTTONS
   ================================ */

QPushButton {
    background-color: #333333;
    color: #FFFFFF;

    border: none;
    border-radius: 35px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 26px;
    font-weight: 500;

    padding: 10px;
}


/* Button hover */

QPushButton:hover {
    background-color: #444444;
}


/* Button pressed */

QPushButton:pressed {
    background-color: #666666;
}


/* ================================
   OPERATORS - ORANGE
   ================================ */

QPushButton#btnAdd,
QPushButton#btnSubstract,
QPushButton#btnMultiply,
QPushButton#btnDivide,
QPushButton#btnEqual {

    background-color: #FF9500;
    color: #FFFFFF;

    border-radius: 35px;
}


/* Operator hover */

QPushButton#btnAdd:hover,
QPushButton#btnSubstract:hover,
QPushButton#btnMultiply:hover,
QPushButton#btnDivide:hover,
QPushButton#btnEqual:hover {

    background-color: #FFB340;
}


/* Operator pressed */

QPushButton#btnAdd:pressed,
QPushButton#btnSubstract:pressed,
QPushButton#btnMultiply:pressed,
QPushButton#btnDivide:pressed,
QPushButton#btnEqual:pressed {

    background-color: #CC7700;
}


/* ================================
   CLEAR BUTTON
   ================================ */

QPushButton#btnClear {

    background-color: #A5A5A5;
    color: #000000;

    border-radius: 35px;
}


QPushButton#btnClear:hover {
    background-color: #C5C5C5;
}


QPushButton#btnClear:pressed {
    background-color: #777777;
}


/* ================================
   NUMBER BUTTONS
   ================================ */

QPushButton#btn0,
QPushButton#btn1,
QPushButton#btn2,
QPushButton#btn3,
QPushButton#btn4,
QPushButton#btn5,
QPushButton#btn6,
QPushButton#btn7,
QPushButton#btn8,
QPushButton#btn9 {

    background-color: #333333;
    color: #FFFFFF;

    border-radius: 35px;
}


QPushButton#btn0:hover,
QPushButton#btn1:hover,
QPushButton#btn2:hover,
QPushButton#btn3:hover,
QPushButton#btn4:hover,
QPushButton#btn5:hover,
QPushButton#btn6:hover,
QPushButton#btn7:hover,
QPushButton#btn8:hover,
QPushButton#btn9:hover {

    background-color: #444444;
}</string>
